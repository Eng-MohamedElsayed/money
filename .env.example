# Environment variables — copy to .env.local and fill in real values.
# Never commit secrets.

# Pooled connection for application runtime (React Query route handlers).
# From Neon Console -> Connect -> Connection string (pooled). Note the "-pooler" host suffix.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection for Prisma CLI commands (migrations, seed, introspection).
# Same as DIRECT but WITHOUT the "-pooler" host suffix.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Public (browser-safe) config.
NEXT_PUBLIC_APP_NAME="Money Allocation"
# Default currency code. Domain logic stays currency-agnostic; this only configures display.
NEXT_PUBLIC_DEFAULT_CURRENCY="EGP"

# Temporary MVP development identity — see docs/architecture.md.
# The seed script creates a default user with this id so the app works without auth.
DEV_USER_ID="user_default"
# Clerk (https://dashboard.clerk.com) — paste real keys into .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
