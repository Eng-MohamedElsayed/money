{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/**/*.ts": {
      "runtime": "nodejs",
      "regions": ["iad1"],
      "maxDuration": 30
    },
    "src/app/api/**/route.ts": {
      "runtime": "nodejs",
      "regions": ["iad1"],
      "maxDuration": 30
    }
  }
}
